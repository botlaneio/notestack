{
  "name": "notestack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:static": "node scripts/build-static.mjs",
    "build:cloudflare": "npm run build:static && vite build --config cloudflare/vite.config.ts",
    "deploy:cloudflare": "cd cloudflare && cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "latest",
    "lucide-react": "latest",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.17",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf": "^1.0.0-beta.32",
    "typescript": "^5",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
